{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Beetle Memory",
  "version": "0.6.0",
  "identifier": "com.beetlememory.desktop",
  "build": {
    "beforeDevCommand": "npm --prefix ../console run dev -- --host 127.0.0.1 --port 5176",
    "devUrl": "http://127.0.0.1:5176",
    "beforeBuildCommand": "node scripts/build-sidecars.mjs",
    "frontendDist": "../../console/dist"
  },
  "app": {
    "windows": [
      {
        "title": "Beetle Memory",
        "label": "main",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 680,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "capabilities": ["default"],
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "externalBin": ["../../../target/release/bm-llm-gateway"]
  }
}
